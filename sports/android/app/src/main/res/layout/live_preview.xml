<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.novatv.app.ui.AspectFrame
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:focusable="true"
        android:clickable="true"
        app:ratio="0.5625">

        <androidx.media3.ui.PlayerView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            app:resize_mode="fit"
            app:show_buffering="always"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <ImageView
            android:id="@+id/previewLogo"
            android:layout_width="96dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:alpha="0.5"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv" />

        <TextView
            android:id="@+id/previewMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnGuide"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="92dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Guia de programação"
            android:focusable="true"
            android:clickable="true"
            android:padding="6dp"
            android:src="@drawable/ic_calendar" />

        <ImageView
            android:id="@+id/btnFav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Favoritar"
            android:padding="7dp"
            android:src="@drawable/ic_heart"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnFull"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:contentDescription="Tela cheia"
            android:padding="7dp"
            android:src="@drawable/ic_fullscreen" />
    </com.novatv.app.ui.AspectFrame>

    <LinearLayout
        android:id="@+id/infoBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/nowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Escolha um canal"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/epgProgress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nextEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
